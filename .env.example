# Copy to .env and fill in. Never commit .env. Never put secrets in .py files.

PAYLOAD_URL=https://payload.10beste.com

# --- Auth ---
# This CMS uses 2FA (TOTP). Payload only allows DELETE for:
#   (a) a User API Key, or
#   (b) an email/password session that has been TOTP-verified.
#
# Easiest: set email + password. On first run the script asks for your
# 6-digit authenticator code once, then saves this account's API key below
# automatically so later runs are unattended (API keys bypass TOTP).
PAYLOAD_EMAIL=you@example.com
PAYLOAD_PASSWORD=your-password

# Filled automatically after the first TOTP-verified run (or paste a saved key).
# PAYLOAD_API_KEY=

# Optional: pass the current authenticator code non-interactively (expires in 30s)
# PAYLOAD_TOTP_CODE=123456

GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1-G5IcB_qMuKsVtqPsedmJVhWdmZKy9NP6ed_LPx3kfs/edit?gid=0#gid=0

# DRY_RUN=true
# PAYLOAD_COLLECTION=blog-posts
